// MUSO database schema.
// Conventions: UUID primary keys, snake_case table names, created/updated timestamps,
// soft deletion (deletedAt) on user-generated content. Models are added milestone by milestone.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Keep in sync with USER_ROLES in packages/shared/src/enums.ts
enum Role {
  ARTIST
  CREATOR
  SUPPORTER
  ORGANIZER
  ADMIN
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Null for social-only accounts.
  passwordHash    String?   @map("password_hash")
  /// Lowercase handle, unique. Set during onboarding.
  username        String?   @unique
  displayName     String?   @map("display_name")
  /// Object-storage key (public bucket). The API returns a full URL.
  avatarKey       String?   @map("avatar_key")
  bio             String?
  city            String?
  country         String?   @db.Char(2)
  /// [{ label, url }] — validated by the API.
  links           Json      @default("[]")
  /// Privacy: hide city/country from other users.
  showLocation    Boolean   @default(true) @map("show_location")
  /// Privacy: show earnings achievements publicly (M4+). Private by default.
  showEarnings    Boolean   @default(false) @map("show_earnings")
  onboardedAt     DateTime? @map("onboarded_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  roles             UserRole[]
  sessions          Session[]
  authCodes         AuthCode[]
  artistProfile     ArtistProfile?
  creatorProfile    CreatorProfile?
  organizerProfile  OrganizerProfile?
  organizedEvents   Event[]                 @relation("EventOrganizer")
  reviewedEvents    Event[]                 @relation("EventReviewer")
  eventFollows      EventFollow[]
  posts             Post[]
  likes             Like[]
  savedPosts        SavedPost[]
  comments          Comment[]
  following         Follow[]                @relation("Follower")
  followers         Follow[]                @relation("Followee")
  blocking          Block[]                 @relation("Blocker")
  blockedBy         Block[]                 @relation("Blocked")
  reports           Report[]                @relation("Reporter")
  notifications     Notification[]          @relation("NotificationRecipient")
  notificationsSent Notification[]          @relation("NotificationActor")
  interests         UserInterest[]
  paymentsMade      PaymentIntent[]         @relation("Payer")
  paymentsReceived  PaymentIntent[]         @relation("Payee")
  entitlements      ContentEntitlement[]
  earnings          Earning[]
  priceChanges      ContentPricingHistory[]

  @@map("users")
}

/// A user may hold several roles (e.g. a fan who is also a creator).
model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Genre {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  artists ArtistGenre[]
  fans    UserInterest[]

  @@map("genres")
}

/// One row per signed-in device. Refresh tokens are rotated on every use and stored only as SHA-256 hashes.
/// Reuse of an already-rotated token revokes the whole family (token theft detection).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// Identifies the chain of rotated tokens issued from one sign-in.
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  /// Set when this token was exchanged for a newer one.
  rotatedAt        DateTime? @map("rotated_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Short-lived one-time codes (stored hashed) for email verification and password reset.
model AuthCode {
  id         String          @id @default(uuid(7)) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  purpose    AuthCodePurpose
  codeHash   String          @map("code_hash")
  attempts   Int             @default(0)
  expiresAt  DateTime        @map("expires_at")
  consumedAt DateTime?       @map("consumed_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_codes")
}

// ─────────────────────────────── Profiles (M2) ───────────────────────────────

model ArtistProfile {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  stageName          String             @map("stage_name")
  coverKey           String?            @map("cover_key")
  /// Artist-defined permitted usage of fan content (shown to creators; enforced in M3/M5).
  contentUsagePolicy ContentUsagePolicy @default(PERSONAL_SHARING_ONLY) @map("content_usage_policy")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  genres        ArtistGenre[]
  eventSlots    EventArtist[]
  taggedIn      PostArtist[]
  scheduleItems EventScheduleItem[]

  @@index([stageName])
  @@map("artist_profiles")
}

enum ContentUsagePolicy {
  /// Fans may post and share; commercial use needs a licence.
  PERSONAL_SHARING_ONLY
  /// Fans may post, share and sell access to their own captures.
  FAN_MONETIZATION_ALLOWED
  /// Artist asks fans not to post recordings.
  NO_RECORDINGS
}

model ArtistGenre {
  artistId String @map("artist_id") @db.Uuid
  genreId  String @map("genre_id") @db.Uuid

  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre         @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
  @@map("artist_genres")
}

enum CreatorFocus {
  PHOTOGRAPHY
  VIDEOGRAPHY
}

model CreatorProfile {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @unique @map("user_id") @db.Uuid
  focus        CreatorFocus[]
  portfolioUrl String?        @map("portfolio_url")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model OrganizerProfile {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  organizationName String   @map("organization_name")
  contactEmail     String   @map("contact_email")
  contactPhone     String?  @map("contact_phone")
  website          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizer_profiles")
}

// ──────────────────────────────── Events (M2) ────────────────────────────────

/// Lifecycle (UPCOMING / LIVE / COMPLETED / CANCELLED) is derived from
/// startsAt / endsAt / cancelledAt, so it can never drift out of sync.
model Event {
  id              String            @id @default(uuid(7)) @db.Uuid
  organizerId     String            @map("organizer_id") @db.Uuid
  title           String
  description     String
  coverKey        String?           @map("cover_key")
  venueName       String            @map("venue_name")
  address         String?
  city            String
  country         String            @db.Char(2)
  startsAt        DateTime          @map("starts_at")
  endsAt          DateTime          @map("ends_at")
  recordingPolicy RecordingPolicy   @default(ALLOWED) @map("recording_policy")
  recordingNotes  String?           @map("recording_notes")
  reviewStatus    EventReviewStatus @default(PENDING) @map("review_status")
  reviewNote      String?           @map("review_note")
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at")
  cancelledAt     DateTime?         @map("cancelled_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  organizer  User                @relation("EventOrganizer", fields: [organizerId], references: [id])
  reviewedBy User?               @relation("EventReviewer", fields: [reviewedById], references: [id])
  artists    EventArtist[]
  schedule   EventScheduleItem[]
  followers  EventFollow[]
  posts      Post[]

  @@index([reviewStatus, startsAt])
  @@index([reviewStatus, endsAt])
  @@index([organizerId])
  @@index([city])
  @@map("events")
}

enum RecordingPolicy {
  ALLOWED
  PHOTOS_ONLY
  NOT_ALLOWED
}

/// Events are only publicly visible once approved.
enum EventReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model EventArtist {
  eventId   String   @map("event_id") @db.Uuid
  artistId  String   @map("artist_id") @db.Uuid
  /// 0 = headliner, ascending billing order.
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@index([artistId])
  @@map("event_artists")
}

model EventScheduleItem {
  id        String    @id @default(uuid(7)) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  title     String
  stage     String?
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  artistId  String?   @map("artist_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  event  Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist ArtistProfile? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([eventId, startsAt])
  @@map("event_schedule_items")
}

model EventFollow {
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
  @@map("event_follows")
}

// ──────────────────────────── Content & social (M3) ────────────────────────────

/// Fan genre interests used to personalise the feed.
model UserInterest {
  userId    String   @map("user_id") @db.Uuid
  genreId   String   @map("genre_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([userId, genreId])
  @@map("user_interests")
}

enum MediaType {
  PHOTO
  VIDEO
}

enum PostStatus {
  /// Upload received, derivatives being generated.
  PROCESSING
  PUBLISHED
  /// Media couldn't be processed (corrupt / unsupported / too long).
  FAILED
}

enum ModerationStatus {
  VISIBLE
  /// Hidden by a moderator or automatically after enough reports.
  HIDDEN
}

/// Only FREE is accepted until Milestone 4.
enum MonetizationMode {
  FREE
  PAY_TO_UNLOCK
  PAY_WHAT_YOU_WANT
}

/// Whether the artist has licensed this capture for their own use. Fan captures are never
/// treated as official artist content by default.
enum ContentPermissionStatus {
  NOT_REQUESTED
  REQUESTED
  GRANTED
  DECLINED
}

model Post {
  id                String                  @id @default(uuid(7)) @db.Uuid
  authorId          String                  @map("author_id") @db.Uuid
  eventId           String?                 @map("event_id") @db.Uuid
  type              MediaType
  caption           String                  @default("")
  hashtags          String[]
  status            PostStatus              @default(PROCESSING)
  failureReason     String?                 @map("failure_reason")
  moderationStatus  ModerationStatus        @default(VISIBLE) @map("moderation_status")
  monetizationMode  MonetizationMode        @default(FREE) @map("monetization_mode")
  /// Price in minor units (paise). PAY_TO_UNLOCK only.
  priceMinor        Int?                    @map("price_minor")
  /// PAY_WHAT_YOU_WANT: suggested and optional minimum, in minor units.
  suggestedMinor    Int?                    @map("suggested_minor")
  minimumMinor      Int?                    @map("minimum_minor")
  /// PAY_WHAT_YOU_WANT: true = viewers must contribute to see it; false = public, contributions optional.
  pwywGated         Boolean                 @default(true) @map("pwyw_gated")
  currency          String                  @default("INR") @db.Char(3)
  tipsEnabled       Boolean                 @default(true) @map("tips_enabled")
  /// True only when the author is one of the tagged artists.
  isOfficial        Boolean                 @default(false) @map("is_official")
  permissionStatus  ContentPermissionStatus @default(NOT_REQUESTED) @map("permission_status")
  /// Uploader confirmed they captured this and have the right to share it.
  rightsConfirmedAt DateTime                @map("rights_confirmed_at")
  /// Client idempotency key: retrying a publish never creates duplicates.
  clientRequestId   String                  @map("client_request_id")
  likeCount         Int                     @default(0) @map("like_count")
  commentCount      Int                     @default(0) @map("comment_count")
  saveCount         Int                     @default(0) @map("save_count")
  reportCount       Int                     @default(0) @map("report_count")
  publishedAt       DateTime?               @map("published_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  deletedAt         DateTime?               @map("deleted_at")

  author         User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  event          Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  media          PostMedia[]
  artists        PostArtist[]
  likes          Like[]
  saves          SavedPost[]
  comments       Comment[]
  notifications  Notification[]
  pricingHistory ContentPricingHistory[]
  entitlements   ContentEntitlement[]
  payments       PaymentIntent[]
  earnings       Earning[]

  @@unique([authorId, clientRequestId])
  @@index([status, moderationStatus, publishedAt])
  @@index([eventId, publishedAt])
  @@index([authorId, publishedAt])
  @@index([hashtags], type: Gin)
  @@map("posts")
}

/// Originals live in the private bucket and are never served directly.
/// Display/thumbnail derivatives are generated by the media worker.
model PostMedia {
  id          String    @id @default(uuid(7)) @db.Uuid
  postId      String    @map("post_id") @db.Uuid
  position    Int       @default(0)
  type        MediaType
  originalKey String    @unique @map("original_key")
  displayKey  String?   @map("display_key")
  thumbKey    String?   @map("thumb_key")
  /// Heavily blurred preview shown on locked content.
  previewKey  String?   @map("preview_key")
  /// Full-resolution, metadata-stripped photo for buyers' downloads.
  fullKey     String?   @map("full_key")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  width       Int?
  height      Int?
  durationMs  Int?      @map("duration_ms")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@map("post_media")
}

model PostArtist {
  postId   String @map("post_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid

  post   Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  artist ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([postId, artistId])
  @@index([artistId])
  @@map("post_artists")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId, createdAt])
  @@map("likes")
}

model SavedPost {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  /// One level of replies: the parent must be a top-level comment.
  parentId  String?   @map("parent_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("Replies")
  notifications Notification[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@map("comments")
}

/// User-to-user follows (fans following artists and creators).
model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

/// Blocking hides each other's content and prevents follows, comments and mentions.
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  NUDITY
  VIOLENCE
  COPYRIGHT
  PRIVACY
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id         String           @id @default(uuid(7)) @db.Uuid
  reporterId String           @map("reporter_id") @db.Uuid
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  /// One report per person per target.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

enum NotificationType {
  NEW_FOLLOWER
  POST_LIKED
  POST_COMMENTED
  COMMENT_REPLIED
  MENTIONED
  TAGGED_IN_POST
  POST_PUBLISHED
  POST_FAILED
  CONTENT_PURCHASED
  TIP_RECEIVED
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  actorId   String?          @map("actor_id") @db.Uuid
  postId    String?          @map("post_id") @db.Uuid
  commentId String?          @map("comment_id") @db.Uuid
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────── Money (M4) ───────────────────────────────
// All amounts are integers in minor units (paise). No floats anywhere.

/// Every change of a post's price/mode. Buyers keep access regardless of later changes.
model ContentPricingHistory {
  id             String           @id @default(uuid(7)) @db.Uuid
  postId         String           @map("post_id") @db.Uuid
  changedById    String           @map("changed_by_id") @db.Uuid
  mode           MonetizationMode
  priceMinor     Int?             @map("price_minor")
  suggestedMinor Int?             @map("suggested_minor")
  minimumMinor   Int?             @map("minimum_minor")
  pwywGated      Boolean          @map("pwyw_gated")
  tipsEnabled    Boolean          @map("tips_enabled")
  createdAt      DateTime         @default(now()) @map("created_at")

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("content_pricing_history")
}

enum PaymentKind {
  UNLOCK
  TIP
}

enum PaymentStatus {
  /// Intent created, checkout not completed yet.
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

/// A payer's attempt to pay. Status is only ever advanced by the server after verifying with the
/// provider — never from client-submitted data.
model PaymentIntent {
  id             String        @id @default(uuid(7)) @db.Uuid
  payerId        String        @map("payer_id") @db.Uuid
  payeeId        String        @map("payee_id") @db.Uuid
  postId         String?       @map("post_id") @db.Uuid
  kind           PaymentKind
  amountMinor    Int           @map("amount_minor")
  currency       String        @default("INR") @db.Char(3)
  /// Fee snapshot at creation (basis points), so later fee changes don't alter old payments.
  feeBps         Int           @map("fee_bps")
  status         PaymentStatus @default(PENDING)
  provider       String
  providerRef    String?       @map("provider_ref")
  checkoutUrl    String?       @map("checkout_url")
  /// Client-supplied idempotency key, unique per payer.
  idempotencyKey String        @map("idempotency_key")
  message        String?
  failureReason  String?       @map("failure_reason")
  expiresAt      DateTime      @map("expires_at")
  succeededAt    DateTime?     @map("succeeded_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  payer       User                @relation("Payer", fields: [payerId], references: [id])
  payee       User                @relation("Payee", fields: [payeeId], references: [id])
  post        Post?               @relation(fields: [postId], references: [id], onDelete: SetNull)
  entitlement ContentEntitlement?
  earning     Earning?

  @@unique([payerId, idempotencyKey])
  @@unique([provider, providerRef])
  @@index([status, createdAt])
  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
  @@map("payment_intents")
}

/// Permanent access to paid content. Survives price changes.
model ContentEntitlement {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  paymentId String   @unique @map("payment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  payment PaymentIntent @relation(fields: [paymentId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
  @@map("content_entitlements")
}

enum EarningSource {
  TIP
  PHOTO_SALE
  VIDEO_SALE
  WATCH_REWARD
}

/// Lifecycle: ESTIMATED (rewards, M5) → PENDING (paid, in hold window) → AVAILABLE (withdrawable)
/// → PAID (paid out, M7). REVERSED on refunds/chargebacks. Each transition posts ledger entries.
enum EarningStatus {
  ESTIMATED
  PENDING
  CONFIRMED
  AVAILABLE
  PAID
  REVERSED
}

model Earning {
  id          String        @id @default(uuid(7)) @db.Uuid
  creatorId   String        @map("creator_id") @db.Uuid
  source      EarningSource
  paymentId   String?       @unique @map("payment_id") @db.Uuid
  postId      String?       @map("post_id") @db.Uuid
  grossMinor  Int           @map("gross_minor")
  feeMinor    Int           @map("fee_minor")
  netMinor    Int           @map("net_minor")
  currency    String        @default("INR") @db.Char(3)
  status      EarningStatus
  availableAt DateTime      @map("available_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  creator User           @relation(fields: [creatorId], references: [id])
  payment PaymentIntent? @relation(fields: [paymentId], references: [id])
  post    Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
  @@index([status, availableAt])
  @@map("earnings")
}

/// Double-entry, append-only ledger. Every journal (one business event) sums to zero.
/// UPDATE and DELETE are blocked by a database trigger.
model LedgerEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  journalId   String   @map("journal_id") @db.Uuid
  /// e.g. "provider:sandbox:clearing", "creator:<uuid>:pending", "platform:fees"
  account     String
  userId      String?  @map("user_id") @db.Uuid
  amountMinor Int      @map("amount_minor")
  currency    String   @db.Char(3)
  /// What happened: PAYMENT_CAPTURED, EARNING_RELEASED, ...
  event       String
  paymentId   String?  @map("payment_id") @db.Uuid
  earningId   String?  @map("earning_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([journalId])
  @@index([account])
  @@index([userId, createdAt])
  @@map("ledger_entries")
}

/// Test-only stand-in for an external payment processor's records (sandbox provider).
model SandboxPayment {
  ref         String    @id
  amountMinor Int       @map("amount_minor")
  currency    String    @db.Char(3)
  status      String
  returnUrl   String    @map("return_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@map("sandbox_payments")
}
