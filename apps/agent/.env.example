# MUSO buyer agent — copy to apps/agent/.env (never commit it)
MUSO_API_URL=http://localhost:4000
# Hedera testnet account that pays (needs testnet USDC 0.0.429274 + association)
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=hedera:testnet
# Spending policy (USD)
AGENT_BUDGET_USD=2.00
AGENT_MAX_PER_ITEM_USD=0.75
AGENT_MAX_PER_CREATOR_USD=1.00
# Optional: only buy from these creators (usernames or ids, comma-separated)
AGENT_ALLOWLIST=
# Optional: what to look for (matches title, event, city or artist)
AGENT_QUERY=
# How many items to buy at most this run
AGENT_MAX_ITEMS=3
# Set to true to discover + decide without paying
AGENT_DRY_RUN=false
