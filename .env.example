# Copy to .env and fill in. NEVER commit .env.

# ---- Backend ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://muso:muso_dev@localhost:5432/muso_dev?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated browser origins allowed by CORS (native apps don't need this)
CORS_ORIGINS=http://localhost:8081
RATE_LIMIT_PER_MINUTE=120

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- Object storage (S3-compatible; MinIO in dev: `brew services start minio`) ----
S3_ENDPOINT=http://localhost:9000
# What the phone uses to reach storage. On a device use your Mac's LAN IP.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PUBLIC=muso-public
S3_BUCKET_PRIVATE=muso-private
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKETS=true

# ---- Payments (M4) ----
# sandbox = simulated hosted checkout, no real money (refused when NODE_ENV=production)
PAYMENTS_PROVIDER=sandbox
# USD = fans pay unlocks and tips in USDC on Arc, wallet to wallet (needs ARC_ENABLED=true)
PAYMENTS_CURRENCY=INR
PAYMENTS_SIGNING_SECRET=change-me-generate-with-openssl-rand-base64-48
# Base URL the phone uses to reach the API (LAN IP on a device)
PUBLIC_API_URL=http://localhost:4000
PLATFORM_FEE_BPS_SALES=1000
PLATFORM_FEE_BPS_TIPS=500
# Pending earnings become withdrawable after this many minutes (default 7 days)
EARNINGS_HOLD_MINUTES=10080

# ---- x402 on Hedera (H1: AI agents buy paid content) ----
X402_ENABLED=false
X402_NETWORK=hedera:testnet
X402_FACILITATOR_URL=https://x402.org/facilitator
# MUSO treasury Hedera account (must be associated with testnet USDC 0.0.429274)
X402_PAY_TO=
X402_INR_PER_USD=84

# ---- Arc (H2: on-chain USDC reward campaigns) ----
ARC_ENABLED=false
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
# RewardCampaigns contract (built in Arc Studio), Arc testnet
ARC_REWARD_CAMPAIGNS_ADDRESS=0x7cbbb1f0e9d7301c16e6d544f9a55d13030f74eb
# Allocator/relayer wallet: awards creators and submits their claims. Testnet only; fund with faucet USDC.
ARC_ALLOCATOR_PRIVATE_KEY=
# https URL wallet apps can open for MUSO's wallet page (dev: `ngrok http 4000`). Defaults to PUBLIC_API_URL.
# ARC_PUBLIC_URL=https://your-tunnel.ngrok-free.app

# ---- World ID (H3: one verified human per account; required to earn from human-only pools) ----
WORLD_ID_ENABLED=false
# From developer.world.org (World ID 4.0): app_…, rp_… and the RP signing key (secret, server only)
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
WORLD_ID_ACTION=muso-creator-rewards
# staging = World ID Simulator (simulator.worldcoin.org); production = real World App
WORLD_ID_ENVIRONMENT=staging

# ---- Arkiv (public proof: events, clips, attention reports, payout receipts) ----
ARKIV_ENABLED=false
# MUSO's writer wallet on Rabdi testnet; fund with tGLM at hub.arkiv.network/faucet
ARKIV_WRITER_PRIVATE_KEY=
# Free key from hub.arkiv.network/access-keys (the public RPC is heavily rate limited)
ARKIV_ACCESS_KEY=

# ---- Predictions (testnet prediction game on any event; PredictionPools on Arc) ----
PREDICTIONS_ENABLED=false
# Deployed PredictionPools (USDC on Arc). ARC_ALLOCATOR_PRIVATE_KEY is its resolver + ticket signer.
PREDICTIONS_CONTRACT_ADDRESS=

# ---- ENS (free <username>.muso.eth subnames, served by MUSO's CCIP-Read gateway) ----
ENS_ENABLED=false
# Parent name you own on ENS; set its resolver to MusoOffchainResolver
ENS_PARENT_NAME=muso.eth
# Ethereum network the parent name is on: sepolia | mainnet
ENS_CHAIN=sepolia
# Used only to read other people's ENS names (e.g. a sponsor's brand.eth)
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Gateway signing key (0x… 32-byte hex). Generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
ENS_SIGNER_PRIVATE_KEY=
# Deployed MusoOffchainResolver (informational)
ENS_RESOLVER_ADDRESS=

# ---- Tests (used by `pnpm test:e2e`) ----
TEST_DATABASE_URL=postgresql://muso:muso_dev@localhost:5432/muso_test?schema=public
